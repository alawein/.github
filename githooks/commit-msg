#!/usr/bin/env bash
# Reject AI attribution in a commit message before it reaches history.
# Mirrors ATTRIBUTION in scripts/check-pr-policy.py. Enable per checkout:
#   git config core.hooksPath githooks
set -euo pipefail

msg="$(grep -v '^#' "$1" || true)"
trailer='^[[:space:]]*co-authored-by[[:space:]]*:.*\b(claude|anthropic|gpt|openai|codex|cursor|copilot|gemini|kilo|grok|assistant|agent|bot)\b'
footer='^[^[:alnum:]]*(generated with\b|generated by\b|made with\b)'

hits="$(
  {
    printf '%s\n' "$msg" | grep -Ei "$trailer"
    printf '%s\n' "$msg" | grep -Ei "$footer" | grep -Eiv 'generated by[[:space:]]+scripts/'
  } || true
)"

if [ -n "$hits" ]; then
  echo "commit-msg: AI attribution found. Remove it and commit again:" >&2
  printf '%s\n' "$hits" >&2
  exit 1
fi
